<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" authoring-id="-1165872441" editor-extension-mode="False">
    <ui:VisualElement name="MainHUD" style="flex-grow: 1; position: absolute;">
        <ui:Label text="Label" name="DateTimeLabel" style="text-overflow: clip; color: rgb(255, 255, 255);"/>
        <ui:Button text="Pause" name="PauseButton" style="height: 25px; width: 54px; white-space: pre; -unity-text-align: middle-center;"/>
        <ui:Button text="1x" name="NormalButton" style="height: 25px; width: 54px;"/>
        <ui:Button text="60x" name="FastButton" style="height: 25px; width: 54px;"/>
        <ui:Button text="3600x" name="VeryFastButton" style="height: 25px; width: 68px;"/>
        <ui:Button text="86400x" name="UltraFastButton" style="height: 25px; width: 68px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="EventLayer" style="flex-grow: 1;">
        <ui:VisualElement name="EventWindow" style="flex-grow: 1; flex-direction: column; width: 600px; min-height: 400px; padding-top: 24px; padding-right: 24px; padding-bottom: 24px; padding-left: 24px; background-color: rgb(35, 35, 35); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgb(100, 100, 100); border-right-color: rgb(100, 100, 100); border-bottom-color: rgb(100, 100, 100); border-left-color: rgb(100, 100, 100);">
            <ui:Label text="Label" name="EventTitle" style="position: relative; font-size: 28px; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-bottom: 28px; margin-right: 0; margin-top: 0; margin-left: 0; -unity-text-align: middle-center; color: rgb(200, 200, 200);"/>
            <ui:Image name="EventImage" style="width: 100%; height: 240px;"/>
            <ui:Label text="Label" name="EventDescription" style="color: rgb(200, 200, 200); font-size: 16px; padding-bottom: 24px;"/>
            <ui:VisualElement name="EventButtons" style="flex-grow: 1; flex-direction: row; justify-content: center;">
                <ui:Button text="Continue" name="ContinueButton" enable-rich-text="false" style="width: 140px; height: 40px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
